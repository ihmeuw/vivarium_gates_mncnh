    "ap = (mh * (1 - pp_fraction_prepped)).reset_index()\n",
    "ap[\"cause\"] = \"antepartum_hemorrhage\"\n",
    "\n",
    "artifact_rates_prepped = pd.concat([artifact_rates_prepped, pp, ap])\n",
    "artifact_rates_prepped"
