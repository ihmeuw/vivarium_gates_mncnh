    "if has_anemia_ylds:\n",
    "    gbd_anemia_ylds = get_outputs(\n",
    "        location_id=list(location_ids.location_id),\n",
    "        topic='rei',\n",
    "        rei_id=192, # rei_id=192 for all anemia\n",
    "        population_group_id=16, # pregnant population\n",
    "        sex_id=2, # female\n",
    "        year_id=2023,\n",
    "        release_id=33, # GBD 2023, special publications\n",
    "        measure_id=3, # YLDs\n",
    "        metric_id=1, # count\n",
    "        age_group_id=[7, 8, 9, 10, 11, 12, 13, 14, 15], # constituent age groups of 10-54 years (169)\n",
    "    )\n",
    "    assert np.allclose(\n",
    "        gbd_anemia_ylds.groupby(['location_id', 'age_group_id'])[['val']].sum().sort_index().values,\n",
    "        get_outputs(\n",
    "            location_id=list(most_detailed_locations.location_id),\n",
    "            topic='rei',\n",
    "            rei_id=192, # rei_id=192 for all anemia\n",
    "            population_group_id=16, # pregnant population\n",
    "            sex_id=2, # female\n",
    "            year_id=2023,\n",
    "            release_id=33, # GBD 2023, special publications\n",
    "            measure_id=3, # YLDs\n",
    "            metric_id=1, # count\n",
    "            age_group_id=[7, 8, 9, 10, 11, 12, 13, 14, 15], # constituent age groups of 10-54 years (169)\n",
    "        ).merge(\n",
    "            most_detailed_locations[['location_id', 'parent_id']],\n",
    "            on='location_id'\n",
    "        ).groupby(['parent_id', 'age_group_id'])[['val']].sum().sort_index().values\n",
    "    ), \"GBD aggregation of anemia YLDs in count space does not match the sum of the most detailed locations\"\n",
    "\n",
    "    gbd_anemia_ylds = gbd_anemia_ylds.set_index(['location_name', 'age_group_id'])[['val', 'upper', 'lower']].sort_index()\n",
    "    gbd_anemia_ylds[['age_start', 'age_end']] = age_spans.reindex(gbd_anemia_ylds.index.get_level_values('age_group_id')).values\n",
