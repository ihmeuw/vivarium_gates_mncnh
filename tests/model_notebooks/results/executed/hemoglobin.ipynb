   "source": [
    "if has_anemia_ylds:\n",
    "    gbd_anemia_yld_rates_by_severity_draws = get_draws(\n",
    "        gbd_id_type='rei_id',\n",
    "        gbd_id=[205, 206, 207], # mild, moderate, and severe anemia, respectively\n",
    "        location_id=list(location_ids.location_id),\n",
    "        population_group_id=16, # pregnant population\n",
    "        sex_id=2, # female\n",
    "        year_id=2023,\n",
    "        release_id=33, # GBD 2023, special publications\n",
    "        measure_id=3, # YLDs\n",
    "        metric_id=3, # rate\n",
    "        source='como',\n",
    "        age_group_id=[7, 8, 9, 10, 11, 12, 13, 14, 15], # constituent age groups of 10-54 years (169)\n",
    "    ).query(\"cause_id == 294\").set_index(['location_id', 'age_group_id', 'rei_id']).filter(like='draw')\n",
    "    gbd_anemia_yld_rates_by_severity_draws[['age_start', 'age_end']] = age_spans.reindex(gbd_anemia_yld_rates_by_severity_draws.index.get_level_values('age_group_id')).values\n",
    "    gbd_anemia_yld_rates_by_severity_draws = gbd_anemia_yld_rates_by_severity_draws.join(location_ids.set_index('location_id')['location_name']).rename(columns={'location_name': 'location'})\n",
    "    gbd_anemia_yld_rates_by_severity_draws['anemia_status'] = gbd_anemia_yld_rates_by_severity_draws.index.get_level_values('rei_id').map({205: 'mild', 206: 'moderate', 207: 'severe'})\n",
    "    gbd_anemia_yld_rates_by_severity_draws = gbd_anemia_yld_rates_by_severity_draws.reset_index().rename(columns={'location_name': 'location'}).set_index(['location', 'age_start', 'age_end', 'anemia_status']).drop(columns=['location_id', 'age_group_id', 'rei_id'])\n",
    "    gbd_anemia_yld_rates_by_severity_summary = gbd_anemia_yld_rates_by_severity_draws.T.describe(percentiles=[0.025, 0.5, 0.975]).T.drop(columns='count').add_prefix('gbd_overall_')\n",
    "    gbd_anemia_yld_rates_by_severity_draws = gbd_anemia_yld_rates_by_severity_draws[[f'draw_{i % 100}' for i in [int(d.split('_')[1]) for d in draws]]]\n",
    "    gbd_anemia_yld_rates_by_severity_draws.columns = draws\n",
    "    display(gbd_anemia_yld_rates_by_severity_draws)"
   ]
  },
