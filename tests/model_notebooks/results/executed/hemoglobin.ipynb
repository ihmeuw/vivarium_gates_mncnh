    "if has_anemia_ylds:\n",
    "    # person_time_by_severity = anemia_person_time.query(\"scenario == 'baseline'\").groupby(['location', 'age_group', 'input_draw', 'anemia_status'])['value'].sum()\n",
    "    sim_anemia_yld_rates_by_severity = (\n",
    "        anemia_ylds.query(\"scenario == 'baseline'\").groupby(['location', 'age_group', 'input_draw', 'anemia_status'])['value'].sum() / total_person_time\n",
    "    ).dropna().to_frame()\n",
    "    sim_anemia_yld_rates_by_severity[['age_start', 'age_end']] = sim_anemia_yld_rates_by_severity.index.get_level_values('age_group').to_series().str.split('_to_', expand=True).astype(float).values\n",
    "    sim_anemia_yld_rates_by_severity['age_end'] += 1  # make age_end exclusive to match\n",
    "    sim_anemia_yld_rates_by_severity = sim_anemia_yld_rates_by_severity.reset_index().set_index(['location', 'age_start', 'age_end', 'input_draw', 'anemia_status']).drop(columns='age_group')\n",
    "    sim_anemia_yld_rates_by_severity_summary = sim_anemia_yld_rates_by_severity.groupby(['location', 'age_start', 'age_end', 'anemia_status']).describe(percentiles=[0.025, 0.5, 0.975]).dropna(how='all')['value'].drop(columns='count')\n",
    "    display(sim_anemia_yld_rates_by_severity_summary)"
